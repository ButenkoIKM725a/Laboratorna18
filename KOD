    if (v1 > v2) {
        cout << "Вектор v1 бiльший за вектор v2 за довжиною." << endl;
    }
    else {
        cout << "Вектор v1 НЕ бiльший за вектор v2 за довжиною." << endl;
    }
    return 0;
}
