    SetConsoleCP(1251);
    SetConsoleOutputCP(1251);
    Vector v1(5.0, 12.0);
    Vector v2(3.0, 4.0);
    cout << "Вектор v1: ";
    v1.show();
    cout << ", його довжина = " << v1.length() << endl;
    cout << "Вектор v2: ";
    v2.show();
    cout << ", його довжина = " << v2.length() << endl;
    cout << " " << endl;
    Vector v_res = v1 - v2;
    cout << "Результат вiднiмання (v1 - v2): ";
    v_res.show();
    cout << endl << endl;
    cout << "Перевiрка оператора < :" << endl;
    if (v1 < v2) {
        cout << "Вектор v1 менший за вектор v2 за довжиною." << endl;
    }
    else {
        cout << "Вектор v1 НЕ менший за вектор v2 за довжиною." << endl;
    }
    cout << endl;
