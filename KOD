#include <iostream>
#include <cmath>
#include <windows.h>

using namespace std;

class Vector {
private:
    double x;
    double y;

public:
    Vector() {
        x = 0.0;
        y = 0.0;
    }
    Vector(double x_val, double y_val) {
        x = x_val;
        y = y_val;
    }
    void show() const {
        cout << "(" << x << "; " << y << ")";
    }
    double length() const {
        return sqrt(x * x + y * y);
    }
    Vector operator-(const Vector& op2) const {
        Vector temp;
        temp.x = this->x - op2.x;
        temp.y = this->y - op2.y;
        return temp;
    }
    bool operator<(const Vector& op2) const {
        return this->length() < op2.length();
    }
    bool operator>(const Vector& op2) const {
        return this->length() > op2.length();
    }
};
